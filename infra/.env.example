# Copy to .env (never commit .env). Generate secrets with:  openssl rand -hex 24

# Provider keys — only the LiteLLM container sees these.
DEEPSEEK_API_KEY=
# Used by Dev (alias coder-or). Without it, Dev falls back to DeepSeek Flash.
OPENROUTER_API_KEY=

# Internal secrets.
POSTGRES_PASSWORD=
# Must start with "sk-".
LITELLM_MASTER_KEY=sk-

# Per-agent LiteLLM keys: filled in by  bash infra/create-agent-keys.sh
LEAD_AGENT_KEY=
DEV_AGENT_KEY=
QA_AGENT_KEY=

# Optional: change which model alias an agent uses (see infra/litellm/config.yaml).
# Defaults: LEAD_MODEL=lead, DEV_MODEL=coder-or, QA_MODEL=worker
# DEV_MODEL=worker
