# Copy to .env (never commit .env). Generate secrets with:  openssl rand -hex 24

# Provider keys — only the LiteLLM container sees these.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Internal secrets.
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=sk-                # must start with "sk-"

# Per-agent LiteLLM keys (create in step 2 with per-agent budgets).
LEAD_AGENT_KEY=
DEV_AGENT_KEY=
QA_AGENT_KEY=
