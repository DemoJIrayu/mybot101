# Copy to .env (never commit .env). Generate secrets with:  openssl rand -hex 24

# Provider keys — only the LiteLLM container sees these.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=                   # optional: only if you add OpenRouter models

# Internal secrets.
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=sk-                # must start with "sk-"

# Per-agent LiteLLM keys: filled in by  bash infra/create-agent-keys.sh
LEAD_AGENT_KEY=
DEV_AGENT_KEY=
QA_AGENT_KEY=
