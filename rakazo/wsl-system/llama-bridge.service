[Unit]
Description=Forward 172.17.0.1:18080 (docker bridge only) to Windows llama-server 127.0.0.1:8080
After=docker.service
Requires=docker.service
[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:18080,bind=172.17.0.1,fork,reuseaddr TCP:127.0.0.1:8080
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
